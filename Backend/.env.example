APP_PORT=3100
APP_ENV=development

JWT_SECRET=fmcg-binary-jwt-secret-change-me
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h

DB_HOST=postgres
DB_PORT=5434
DB_USER=fmcg_binary
DB_PASSWORD=fmcg_binary_secret
DB_NAME=fmcg_binary
DB_SSLMODE=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Secure-Coin merchant API credentials (for payout via rewards/issue)
SC_API_BASE=https://api.securecoin.co.in
SC_API_KEY=your-fmcg-merchant-api-key
SC_API_SECRET=your-fmcg-merchant-api-secret

# FMCG platform API base URL (for user sync callbacks)
FMCG_API_BASE=https://api.securemart.co.in
FMCG_API_KEY=fmcg-platform-callback-key
FMCG_API_SECRET=fmcg-platform-callback-secret

# Backblaze B2 (S3-compatible) for KYC document uploads
# Endpoint: S3 endpoint from B2 bucket details, e.g. s3.us-east-005.backblazeb2.com
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_ACCESS_KEY=your-b2-key-id
B2_SECRET_KEY=your-b2-application-key
B2_BUCKET=secure-coin
B2_REGION=us-east-005
B2_USE_SSL=true
